{
  "name": "flux-reader-monorepo",
  "private": true,
  "description": "Flux Reader 多平台 Markdown 阅读器 monorepo",
  "scripts": {
    "install:all": "npm run install:fnos && npm run install:reader",
    "install:fnos": "npm --prefix apps/fnos/backend install",
    "install:reader": "npm --prefix packages/reader-web install",
    "dev": "npm run dev:fnos",
    "dev:fnos": "npm --prefix packages/reader-web run dev",
    "dev:backend": "npm --prefix apps/fnos/backend run dev",
    "dev:reader": "npm --prefix packages/reader-web run dev",
    "dev:frontend": "npm run dev:reader",
    "test": "npm run test:fnos && npm run test:reader",
    "test:fnos": "npm --prefix apps/fnos/backend test",
    "test:reader": "npm --prefix packages/reader-web test",
    "test:frontend": "npm run test:reader",
    "build": "npm run build:fnos",
    "build:reader": "npm --prefix packages/reader-web run build",
    "build:fnos": "node scripts/build-fnos.js",
    "pack": "npm run pack:fnos",
    "pack:fnos": "npm run build:fnos && cd apps/fnos/package && fnpack build"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
